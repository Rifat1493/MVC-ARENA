{
  "extends": "stylelint-config-recommended",
  "customSyntax": "postcss-html",
  "ignoreFiles": [
    "coverage/*",
    "coverage/**",
    "dist/*",
    "dist/**",
    "docs/*",
    "docs/**"
  ],
  "rules": {
    "selector-pseudo-class-no-unknown": [true, { "ignorePseudoClasses": ["deep"] }]
  }
}
