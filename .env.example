# Supabase playtest telemetry
#
# Supabase -> Project Settings -> API Keys
#   Project URL      -> VITE_SUPABASE_URL      (root only, no /rest/v1)
#   Publishable key  -> VITE_SUPABASE_PUBLISHABLE_KEY  (sb_publishable_...)
#
# Never put a SECRET key (sb_secret_...) here. VITE_ variables are compiled
# into the public browser bundle, and a secret key bypasses Row Level Security.
#
# Run supabase/setup.sql once before collecting data.
# Home screen playtest code (recruited players): T1K5M9

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
